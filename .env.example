# ==============================================================================
# Aarambha Tours & Travels Monorepo Environment Variables Reference
# Copy the respective sections to backend/.env, frontend/website/.env.local, and frontend/crm/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (backend/.env)
# ------------------------------------------------------------------------------
PORT=8000
NODE_ENV=production
# MongoDB Atlas Connection String (fallback to in-memory demo database if empty or unreachable)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aarambha_db?retryWrites=true&w=majority
# JWT Secret Key for Session Signing
SECRET_KEY=aarambha-super-secret-key-change-in-production-2026

# Razorpay Payment Gateway Keys (Optional for live online checkout)
RAZORPAY_TOURS_KEY_ID=rzp_live_your_tours_key
RAZORPAY_TOURS_KEY_SECRET=your_tours_secret
RAZORPAY_FLEET_KEY_ID=rzp_live_your_fleet_key
RAZORPAY_FLEET_KEY_SECRET=your_fleet_secret

# Google OAuth Client Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Allowed CORS Origins (Comma-separated for multiple domains)
CORS_ORIGIN=https://aarambhatravels.in,https://admin.aarambhatravels.in,http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. CUSTOMER WEBSITE (frontend/website/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. CRM ADMIN PORTAL (frontend/crm/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000
