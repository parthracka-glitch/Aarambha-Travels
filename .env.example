# ==============================================================================
# Aarambha Tours & Travels — Environment Variables Reference
# ==============================================================================
#
# USAGE:
#   1. Copy this file to the correct location for each service:
#      - Backend:          backend/.env
#      - Website frontend: frontend/website/.env.local
#      - CRM Admin panel:  frontend/crm/.env
#
#   2. Fill in ALL values marked as REQUIRED before deploying to production.
#
#   3. NEVER commit .env files to version control.
#      The .gitignore in this project already excludes all .env* files.
#
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE — copy to: backend/.env
# ------------------------------------------------------------------------------

# Server port
PORT=8000

# Environment: development | production | test
NODE_ENV=production

# MongoDB Atlas Connection String
# Format: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
# REQUIRED in production
MONGODB_URI=

# JWT Secret Key — REQUIRED in production
# Must be at least 32 characters, cryptographically random.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# Allowed CORS Origins — REQUIRED in production
# Comma-separated list of your frontend domains (no trailing slash)
# Example: https://aarambhatravels.in,https://admin.aarambhatravels.in
CORS_ORIGIN=

# Razorpay Payment Gateway Keys (Optional — mock payments used if absent)
RAZORPAY_TOURS_KEY_ID=
RAZORPAY_TOURS_KEY_SECRET=
RAZORPAY_FLEET_KEY_ID=
RAZORPAY_FLEET_KEY_SECRET=

# Google OAuth (Optional — Google login feature)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# 2. CUSTOMER WEBSITE — copy to: frontend/website/.env.local
# ------------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=https://api.aarambhatravels.in
NEXT_PUBLIC_GOOGLE_CLIENT_ID=


# ------------------------------------------------------------------------------
# 3. CRM ADMIN PORTAL — copy to: frontend/crm/.env
# ------------------------------------------------------------------------------

VITE_API_URL=https://api.aarambhatravels.in
